{
  "name": "unwritten-chapters-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply unwritten_chapters_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply unwritten_chapters_db --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "client-zip": "^2.4.5",
    "hono": "^4.7.4",
    "lucide-react": "^0.475.0",
    "photoswipe": "^5.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.8.40",
    "@cloudflare/workers-types": "^4.20250310.0",
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "vitest": "^3.0.9",
    "wrangler": "^3.114.17"
  }
}
